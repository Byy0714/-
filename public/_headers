# CETPass 静态托管缓存策略
# 目标：升级后用户始终拿到最新入口文件，且旧数据（localStorage）不受影响
# 适用：Netlify / Cloudflare Pages 等支持 _headers 的静态托管
# 注意：搜易云不支持 _headers（且拒绝无扩展名文件），构建时会被自动从 dist/ 删除；
#       搜易云的缓存策略请在其控制台手动配置：index.html → no-cache，/assets/* → immutable。

# HTML 入口：每次都重新验证，绝不长期缓存（关键！防止升级后用户拿到旧 index.html）
/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# 带 hash 的静态资源：永久缓存 + immutable（Vite 构建会在内容变化时改名）
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# favicon / 图片等
/favicon.svg
  Cache-Control: public, max-age=604800
/*.svg
  Cache-Control: public, max-age=604800
/*.png
  Cache-Control: public, max-age=604800
/*.jpg
  Cache-Control: public, max-age=604800
/*.webp
  Cache-Control: public, max-age=604800
